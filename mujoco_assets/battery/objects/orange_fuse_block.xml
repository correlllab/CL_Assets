<!-- Orange fuse block. Spawns resting on the near-right battery module top
     (z = 0.932 m, module edge at x = 0.496), as close to the robot as the
     module allows. pos is the world spawn pose; mesh files resolve against
     meshdir, relative to this file. -->
<mujoco model="orange_fuse_block">
    <compiler angle="radian" meshdir="assets" autolimits="true"/>

    <asset>
        <!-- metres, centred on the body origin; built by make_meshes.py -->
        <mesh name="fuse_block_mesh" file="fuse_block.stl"/>

        <material name="orange_plastic" rgba="0.95 0.52 0.09 1.0" shininess="0.3" specular="0.2"/>
        <material name="magenta_sticker" rgba="0.88 0.15 0.55 1.0"/>
        <material name="metal_contacts" rgba="0.6 0.6 0.6 1.0" shininess="0.8" specular="0.8"/>
    </asset>

    <worldbody>
        <!-- z = module top 0.932 + box half-height 0.012 + 3 mm drop -->
        <body name="orange_fuse_block" pos="0.56 -0.20 0.947">
            <freejoint name="fuse_joint"/>

            <!-- Box collision for contact stability; carries the full 0.047 kg -->
            <geom name="fuse_collision_box"
                  type="box"
                  size="0.035 0.013 0.012"
                  mass="0.047"
                  material="orange_plastic"
                  condim="4"
                  friction="0.6 0.005 0.0001"
                  solimp="0.9 0.95 0.001"
                  solref="0.02 1"/>

            <!-- Visual only: the 3D mesh -->
            <geom name="fuse_visual_mesh"
                  type="mesh"
                  mesh="fuse_block_mesh"
                  material="orange_plastic"
                  group="2"
                  density="0"
                  contype="0"
                  conaffinity="0"/>

            <!-- Visual only: the magenta circle on top -->
            <geom name="fuse_sticker_visual"
                  type="cylinder"
                  size="0.005 0.001"
                  pos="0 0 0.012"
                  material="magenta_sticker"
                  group="2"
                  density="0"
                  contype="0"
                  conaffinity="0"/>
        </body>
    </worldbody>
</mujoco>
