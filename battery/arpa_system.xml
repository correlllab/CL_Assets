<mujoco model="arpa_system">
  <!-- ================================================================= -->
  <!-- ARPA disassembly workcell, ported from arpa_description            -->
  <!--   (urdf/arpa_system_macro.urdf.xacro + gantry/linear_actuator      -->
  <!--    xacros). Hand-composed from the URDF's fixed-joint chain so it   -->
  <!--    needs no external ROS packages.                                  -->
  <!--                                                                     -->
  <!-- Included: gantry frame (crossbeam, 2 pillars, 2 feet), the battery  -->
  <!--   pack/table (mesh), and the linear actuator (rail + motor + a      -->
  <!--   prismatic carriage plate + arm-mount plate).                      -->
  <!-- NOT included: the UR16e arm, tool holder, runner, camera — those    -->
  <!--   come from external ur_description / parker packages and hang off   -->
  <!--   the arm's tool0, so they are not part of the standalone cell.      -->
  <!--                                                                     -->
  <!-- View: python CL_Assets/view_mjcf.py CL_Assets/battery/arpa_system.xml
       floor_link (cell origin) sits at world z=0; battery surface ~0.73 m. -->
  <!-- ================================================================= -->

  <compiler angle="radian" autolimits="true"/>
  <option integrator="implicitfast" timestep="0.002">
    <flag multiccd="enable"/>
  </option>

  <statistic center="0 0 1.0" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0.3 0.3 0.3"/>
    <global azimuth="130" elevation="-20"/>
  </visual>

  <asset>
    <!--  scene dressing (drop these three + the floor/light below when
              embedding the cell into another scene, e.g. RoboCasa)  -->
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.90 0.78" rgb2="0.55 0.75 0.58" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="flat" mark="edge"
             rgb1="0.62 0.58 0.52" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>

    <!--  cell materials (from materials.xacro + inline URDF colors)  -->
    <material name="gantry_gray"   rgba="0.9 0.9 0.9 1"  specular="0.3" shininess="0.3"/>
    <material name="pillar_gray"   rgba="0.9 0.9 0.9 1"  specular="0.3" shininess="0.3"/>
    <material name="actuator_gray" rgba="0.75 0.75 0.75 1" specular="0.3" shininess="0.3"/>
    <material name="actuator_plate" rgba="0.0 0.0 0.5 1" specular="0.3" shininess="0.3"/>
    <material name="arm_mount_gray" rgba="0.75 0.75 0.75 1" specular="0.3" shininess="0.3"/>
    <material name="screw_steel"   rgba="0.55 0.55 0.58 1" specular="0.6" shininess="0.5"/>
    <material name="battery_black" rgba="0.1 0.1 0.1 1" specular="0.3" shininess="0.7"/>

    <mesh name="battery" file="meshes/battery.stl"/>
    <mesh name="screw_head" file="meshes/screw_head.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0 0 4.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- floor_link (cell root). Move this body's pos to relocate the whole cell. -->
    <body name="arpa_cell" pos="0 0 0">

      <!-- gantry crossbeam @ z=1.9419 (static / world-welded) -->
      <body name="gantry_link" pos="0 0 1.9419">
        <geom name="gantry_beam" type="box" size="1.5494 0.075 0.075" material="gantry_gray"/>

        <!-- left pillar + foot -->
        <body name="pillar_left_link" pos="1.4744 0 -1.00845">
          <geom name="pillar_left" type="box" size="0.075 0.075 0.9335" material="pillar_gray"/>
          <body name="left_leg_link" pos="0 0 -0.925">
            <geom name="left_leg" type="box" size="0.5 0.5 0.025" material="pillar_gray"/>
          </body>
        </body>

        <!-- right pillar + foot -->
        <body name="pillar_right_link" pos="-1.4744 0 -1.00845">
          <geom name="pillar_right" type="box" size="0.075 0.075 0.9335" material="pillar_gray"/>
          <body name="right_leg_link" pos="0 0 -0.925">
            <geom name="right_leg" type="box" size="0.5 0.5 0.025" material="pillar_gray"/>
          </body>
        </body>

        <!-- battery pack / table (mesh), 90deg about Z, surface ~0.73 m -->
        <body name="battery_link" pos="0.067 -0.0235 -1.1869" euler="0 0 1.57">
          <geom name="battery" type="mesh" mesh="battery" material="battery_black"
                mass="400" contype="0" conaffinity="0"/>
          <!-- Collision proxy: real battery mesh replaced by a flat box for
               contact purposes only (visual mesh above no longer collides).
               2120 x 1225 x 110 mm overall assumes the 2120 mm long axis
               runs along battery_link's local y (matching the screw row's
               ROW_ANGLE_DEG=90 direction); swap the x/y half-extents below
               if that assumption is backwards for your part. Top face sits
               at local z=0, i.e. the mounting plane the screws rest on. -->
          <geom name="battery_collision" type="box" size="0.6125 1.06 0.055" pos="0 0 0.055" group="3"
                friction="1 0.005 0.001" condim="4" priority="1"
                solref="0.004 1" solimp="0.95 0.99 0.001"/>
        </body>

        <!-- linear actuator rail -->
        <body name="linear_actuator_link" pos="0 0 -0.11375">
          <geom name="actuator_rail" type="box" size="1.29 0.075 0.03375" material="actuator_gray"/>

          <!-- actuator motor (fixed to rail) -->
          <body name="actuator_motor_link" pos="1.245 -0.2425 0">
            <geom name="actuator_motor" type="box" size="0.0475 0.1675 0.0475" material="actuator_gray"/>
          </body>

          <!-- carriage plate: prismatic along the rail's x. URDF joint range is
               0.1..2.0 m referenced from the rail base; here zero is re-referenced
               to mid-travel (carriage centered), so range is symmetric. -->
          <body name="linear_actuator_plate_link" pos="0 0 -0.04375">
            <joint name="carriage_slide" type="slide" axis="1 0 0"
                   range="-0.9756 0.9244" damping="50"/>
            <geom name="carriage_plate" type="box" size="0.13 0.075 0.01" mass="5" material="actuator_plate"/>

            <!-- arm mount plate (where the UR16e would bolt on) -->
            <body name="arm_mount_plate" pos="0 0 -0.014" euler="0 0 3.14159">
              <geom name="arm_mount" type="box" size="0.1 0.21 0.004" mass="0.5" material="arm_mount_gray"/>
              <site name="arm_mount_site" pos="0 0 -0.004" size="0.01" rgba="0 1 0 0.3"/>
            </body>
          </body>
        </body>
      </body>
    </body>


